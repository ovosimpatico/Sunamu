{
	// Uncomment this to set a language other than the detected (system) one
	// language: "en",
	// Would you want to use Electron to display Sunamu as a stand alone application?
	useElectron: true,
	// Would you like to spawn a local web server that makes Sunamu accessible through web browsers on your network?
	useWebserver: false,
	// If the option above is true, the option below can be used to define the port where the web server will listen
	webserverPort: 3000,
	// Do you want to run Sunamu in debug mode?
	debugMode: false,
	// Do you want to use the Ozone Wayland Platform? (Linux only)
	waylandOzone: true,
	// How often to poll for track position?
	positionPollInterval: 0.2,
	// Do you want the karaoke feature to be on?
	// It looks better with small poll intervals (<=0.2s), but they make Sunamu perform worse overall on weak setups
	karaoke: true,
	// Do you want the lyrics to be translated? (Apple Music only)
	translations: true,
	// Specify the Apple Music user token here to get synchronized lyrics
	// See plan.md for instructions on how to obtain this
	amMediaUserToken: "",
	// Specify the Apple Music storefront here (default: us)
	amStorefront: "br",
	// Specify the Apple Music language here (default: en-US)
	amLanguage: "pt-BR",
	// Do you want to use Deezer for lyrics? (as fallback)
	deezerSearch: true,
	// Do you want to use LRCLIB for lyrics? (as fallback)
	lrclibFallback: true,
	// Specify your Last.FM username here to get the fancy play count in the details section
	lfmUsername: "",
	// Specify your Spotify Developer Client ID and Secret here to get the Spotify URL for the playing tracks
	spotify: {
		clientID: "",
		clientSecret: "" 
	},
	discordRpc: {
		// Specify if you want your Discord Presence to show what you are playing
		enabled: true,
		// Probably blacklist your browser here lol (unless you do want to show it)
		blacklist: []
	},
	scenes: {
		default: {
			type: "default",
			widgetMode: false,
			font: "",
			theme: "default",
			// nonInteractive: false,
			// static: false,
			// showAlbumArt: true,
			// showControls: true,
			// showProgress: true,
			// showPlayingIndicator: true,
			// showLyrics: true,
			// lyricsBlur: true,
			// clickableLyrics: true,
			// showExtraButtons: true,
			// colors: true,
			// defaultColorsAreInverted: false,
			// colorblock: false,
			// playerIcon: true
		},
		electron: {
			type: "electron",
			widgetMode: true,
			colors: true,
			font: "",
			theme: "default"
		},
		"obs-studio": {
			type: "default",
			widgetMode: true,
			font: "",
			nonInteractive: true,
			static: true,
			showAlbumArt: true,
			showControls: false,
			showProgress: false,
			showPlayingIndicator: false,
			showLyrics: false,
			showExtraButtons: false,
			colors: false
		}
	}
}
